---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { t } from '../i18n'

const locale = 'en'
const strings = t(locale)
---

<BaseLayout title="Page not found — Zenzu" noindex>
  <Header t={strings} locale={locale} />
  <main class="pt-32 pb-24">
    <div class="max-w-xl mx-auto px-6 text-center">
      <p class="text-sm text-ink-2 mb-4">404</p>
      <h1 class="font-serif text-3xl md:text-4xl text-ink mb-4 leading-tight">This path leads nowhere</h1>
      <p class="text-lg text-ink-2 mb-10 leading-relaxed">
        The page you were looking for has moved or never existed.
      </p>
      <div class="flex items-center justify-center gap-6 text-sm">
        <a href="/" class="text-moss hover:underline">Home</a>
        <a href="/blog/" class="text-moss hover:underline">{strings.nav.blog}</a>
        <a href="https://app.zenzu.app" class="text-moss hover:underline">{strings.footer.openApp}</a>
      </div>
    </div>
  </main>
  <Footer t={strings} locale={locale} />
</BaseLayout>
