---
interface Props { t: any }
const { t } = Astro.props
---

<section class="pt-36 pb-24 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <img src="/zenzu-icon.png" alt="Zenzu" class="w-16 h-16 mx-auto mb-10 rounded-2xl" />

    <p class="zz-kicker text-ink-3 mb-8">
      {t.hero.badge}
    </p>

    <h1 class="font-serif text-4xl md:text-6xl text-ink leading-[1.12] mb-8">
      {t.hero.headline1}
      <em class="zz-mark not-italic">{t.hero.headlineHighlight}</em>
      {t.hero.headline2}
    </h1>

    <p class="text-lg md:text-xl text-ink-2 max-w-xl mx-auto mb-12 leading-relaxed">
      {t.hero.subheadline}
    </p>

    <!-- A button pair, as in the app: the action on the left in moss, the
         alternative on the grey pill. -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="https://app.zenzu.app" class="zz-btn px-8 w-full max-w-xs sm:w-auto">
        {t.hero.cta}
      </a>
      <a href="#how-it-works" class="zz-btn zz-btn-cancel px-8 w-full max-w-xs sm:w-auto">
        {t.hero.ctaSecondary}
      </a>
    </div>

    <div class="mt-14 flex flex-col items-center gap-4">
      <span class="text-sm text-ink-3">{t.hero.appStoreBadge}</span>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <a
          href="https://apps.apple.com/app/zenzu-ai-language-mastery/id6761502445"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-3 border border-rule text-ink px-6 py-3 rounded-[16px] hover:border-ink-3 transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 20.28c-.98.95-2.05.86-3.08.4-1.09-.47-2.09-.51-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          <div class="flex flex-col items-start leading-tight text-left">
            <span class="text-[10px] uppercase tracking-wide text-ink-3">Download on the</span>
            <span class="text-base font-medium -mt-0.5">App Store</span>
          </div>
        </a>
        <!-- A plain text link, not a store badge: the Android app is in open
             testing, so it leads to the join steps on this page. -->
        <a
          href="#android"
          class="text-sm text-ink-2 underline decoration-rule underline-offset-4 hover:text-ink hover:decoration-ink-3 transition-colors"
        >
          {t.android.heroLink}
        </a>
      </div>
    </div>

    <p class="mt-12 text-sm text-ink-3">
      {t.hero.supported}
      <span class="mx-2 text-ink-4" aria-hidden="true">·</span>
      <span>{t.hero.comingSoon}</span>
    </p>
  </div>
</section>
