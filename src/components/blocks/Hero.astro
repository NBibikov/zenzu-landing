---
import { WEB_APP_URL } from '../../lib/links'
import Grove from '../ui/Grove.astro'
import StoreBadges from '../ui/StoreBadges.astro'

interface Props { t: any }
const { t } = Astro.props
---

<section class="relative overflow-hidden pt-24 md:pt-36 pb-24 px-6">
  <!-- The column itself is not positioned, so from xl the grove can span the
       full section behind the text. The two text blocks carry z-10. -->
  <div class="max-w-3xl mx-auto text-center">
    <div class="relative z-10">
      <img src="/zenzu-icon.png" alt="Zenzu" class="w-16 h-16 mx-auto mb-6 md:mb-10 rounded-2xl" />

      <h1 class="font-serif text-4xl md:text-6xl text-ink leading-[1.12] mb-5 md:mb-8">
        {/* One line on purpose: the strings carry their own spaces, so a
            comma can follow the highlight without a gap. */}
        {t.hero.headline1}<em class="zz-mark not-italic">{t.hero.headlineHighlight}</em>{t.hero.headline2}
      </h1>

      <!-- The proposition: what one action gives, then the breadth. -->
      <p class="text-xl md:text-2xl text-ink-lead max-w-2xl mx-auto mb-8 md:mb-12 leading-relaxed">
        {t.hero.subheadline}
      </p>

      <!-- One action. "How it works" is a quiet text link, not a second pill. -->
      <div class="flex flex-col items-center gap-2">
        <a href={WEB_APP_URL} class="zz-btn px-8 w-full max-w-xs sm:w-auto">
          {t.app.open}
        </a>
        <a href="#how-it-works" class="inline-flex items-center gap-1.5 min-h-11 px-2 text-sm text-ink-2 hover:text-ink transition-colors">
          {t.hero.ctaSecondary}
          <span aria-hidden="true">&darr;</span>
        </a>
      </div>

      <!-- id="android" keeps old links to the removed Android section working.
           Tight on phones, so both badges show at 390x844 without a scroll. -->
      <div id="android" class="mt-6 md:mt-14 flex flex-col items-center gap-3 md:gap-4">
        <span class="text-sm text-ink-3">{t.hero.appStoreBadge}</span>
        <StoreBadges t={t} />
      </div>
    </div>

    <!-- Below xl: a 140 px strip under the badges. From xl: 320 px across the
         bottom of the hero, trees left and right of the column. -->
    <Grove class="mt-10 h-[140px] xl:absolute xl:inset-x-0 xl:bottom-0 xl:z-0 xl:mt-0 xl:h-[320px]" />

    <p class="relative z-10 mt-12 text-sm text-ink-3">
      {t.hero.supported}
      <span class="mx-2 text-ink-4" aria-hidden="true">·</span>
      <span>{t.hero.comingSoon}</span>
    </p>
  </div>
</section>
