---
interface Props { t: any }
const { t } = Astro.props

// Joining the Play test takes three steps, in this order: join the tester
// group, enrol the account on the testing page, then install from the store
// listing (it opens for that account only after enrolment). Each step is its
// own card with its own link, so a reader who stops halfway sees where to
// resume. The URLs stay here, keyed by step, so no locale can move them.
const steps = [
  { step: '01', href: 'https://groups.google.com/g/zenzu-testers', ...t.android.group },
  { step: '02', href: 'https://play.google.com/apps/testing/com.bblife.zenzu', ...t.android.tester },
  { step: '03', href: 'https://play.google.com/store/apps/details?id=com.bblife.zenzu', ...t.android.install },
]
---

<section id="android" class="py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12 max-w-2xl">
      <p class="zz-kicker text-moss mb-6">{t.android.kicker}</p>
      <h2 class="font-serif text-3xl md:text-4xl text-ink leading-[1.2] mb-4">{t.android.title}</h2>
      <p class="text-ink-2 text-lg leading-relaxed">{t.android.lead}</p>
    </div>

    <ol class="grid gap-4 sm:grid-cols-3">
      {steps.map(({ step, title, cta, href }) => (
        <li class="flex flex-col gap-4 p-6 bg-paper-2 border border-hairline rounded-[16px]">
          <span class="zz-kicker text-[11px] text-ink-3 tabular-nums leading-none" aria-hidden="true">{step}</span>
          <h3 class="font-serif text-xl text-ink">{title}</h3>
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="zz-btn zz-btn-sm mt-auto w-full whitespace-normal"
          >
            {cta}
          </a>
        </li>
      ))}
    </ol>

    <p class="mt-8 text-sm text-ink-3 leading-relaxed max-w-2xl">{t.android.note}</p>
  </div>
</section>
