---
interface Props { t: any }
const { t } = Astro.props

// Open testing on Google Play takes three steps, in this order: the tester
// group grants access, the testing page enrols the account, and only then
// does the store listing let that account install. Each step is its own
// card with its own link, so a reader who stops halfway sees where to resume.
const links = [
  'https://groups.google.com/g/zenzu-testers',
  'https://play.google.com/apps/testing/com.bblife.zenzu',
  'https://play.google.com/store/apps/details?id=com.bblife.zenzu',
]
const steps: { step: string; title: string; cta: string; href: string }[] =
  t.android.steps.map((s: { title: string; cta: string }, i: number) => ({
    ...s,
    step: String(i + 1).padStart(2, '0'),
    href: links[i],
  }))
---

<section id="android" class="py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12 max-w-2xl">
      <p class="zz-kicker text-moss mb-6">{t.android.kicker}</p>
      <h2 class="font-serif text-3xl md:text-4xl text-ink leading-[1.2] mb-4">{t.android.title}</h2>
      <p class="text-ink-2 text-lg leading-relaxed">{t.android.lead}</p>
    </div>

    <ol class="grid gap-4 sm:grid-cols-3">
      {steps.map(({ step, title, cta, href }) => (
        <li class="flex flex-col gap-4 p-6 bg-paper-2 border border-hairline rounded-[16px]">
          <span class="zz-kicker text-[11px] text-ink-3 tabular-nums leading-none">{step}</span>
          <h3 class="font-serif text-xl text-ink">{title}</h3>
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="zz-btn zz-btn-sm mt-auto w-full whitespace-normal"
          >
            {cta}
          </a>
        </li>
      ))}
    </ol>

    <p class="mt-8 text-sm text-ink-3 leading-relaxed max-w-2xl">{t.android.note}</p>
  </div>
</section>
