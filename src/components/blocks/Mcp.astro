---
interface Props { t: any }
const { t } = Astro.props
---

<section class="relative py-20 px-6 bg-surface-dim overflow-hidden">
  <img src="/bridge.png" alt="" class="absolute -bottom-6 -right-6 w-44 opacity-[0.08] pointer-events-none select-none" />

  <div class="relative max-w-3xl mx-auto text-center">
    <span class="inline-block text-moss text-xs font-semibold uppercase tracking-[0.2em] mb-5">
      {t.mcp.kicker}
    </span>
    <h2 class="text-3xl md:text-4xl font-bold text-moss-dark leading-tight mb-6">
      {t.mcp.title}
    </h2>
    <p class="text-on-surface-muted text-lg leading-relaxed max-w-2xl mx-auto mb-8">
      {t.mcp.body}
    </p>
    <span class="inline-flex items-center gap-2 bg-moss-container/50 text-moss-dark px-4 py-1.5 rounded-full text-sm font-medium">
      <span class="w-2 h-2 bg-moss rounded-full animate-pulse"></span>
      {t.mcp.badge}
    </span>
  </div>
</section>
