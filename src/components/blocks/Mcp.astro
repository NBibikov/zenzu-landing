---
interface Props { t: any }
const { t } = Astro.props
---

<section class="py-24 px-6 bg-paper-2">
  <div class="max-w-2xl mx-auto text-center">
    <p class="text-moss text-xs font-medium uppercase tracking-[0.18em] mb-6">
      {t.mcp.kicker}
    </p>
    <h2 class="font-serif text-3xl md:text-4xl text-ink leading-[1.2] mb-6">
      {t.mcp.title}
    </h2>
    <p class="text-ink-2 text-lg leading-relaxed mb-8">
      {t.mcp.body}
    </p>
    <span class="inline-block text-ink-3 text-sm border border-hairline rounded-full px-4 py-1.5">
      {t.mcp.badge}
    </span>
  </div>
</section>
