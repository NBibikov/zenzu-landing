---
import Glyph from '../ui/Glyph.astro'

interface Props { t: any }
const { t } = Astro.props

const forItems: string[] = [t.forWhom.for1, t.forWhom.for2, t.forWhom.for3, t.forWhom.for4, t.forWhom.for5]
const notForItems: string[] = [t.forWhom.notFor1, t.forWhom.notFor2, t.forWhom.notFor3]
// Marks, not bullets: a moss tick for the 'for you' side and a neutral dash
// for the other. A cross would style honest scope as failure.
// Two columns separated by a rule, not two tinted boxes. The 'not for' side
// used to be washed in warm grey with its own bordered chip — styling an
// honest list as if it were a warning. Only the label differs.
---

<section class="py-24 px-6 border-t border-hairline">
  <div class="max-w-4xl mx-auto">
    <div class="max-w-2xl mb-16">
      <h2 class="font-serif text-3xl md:text-4xl text-ink mb-4">{t.forWhom.title}</h2>
      <p class="text-ink-2 text-lg leading-relaxed">{t.forWhom.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      <div>
        <h3 class="text-xs uppercase tracking-[0.18em] text-moss font-medium mb-6">
          {t.forWhom.forLabel}
        </h3>
        <ul>
          {forItems.map((item) => (
            <li class="flex items-start gap-3 text-ink text-[15px] leading-relaxed py-3 border-t border-hairline">
              <Glyph name="tick" size={18} class="text-moss shrink-0 mt-1" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs uppercase tracking-[0.18em] text-ink-3 font-medium mb-6">
          {t.forWhom.notForLabel}
        </h3>
        <ul>
          {notForItems.map((item) => (
            <li class="flex items-start gap-3 text-ink-2 text-[15px] leading-relaxed py-3 border-t border-hairline">
              <Glyph name="dash" size={18} class="text-ink-3 shrink-0 mt-1" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
