---
interface Props { t: any }
const { t } = Astro.props

// Native <details> keeps every answer in the HTML, so crawlers and answer
// engines read it without running any script.
const items: { q: string; a: string }[] = t.faq.items
---

<section id="faq" class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="font-serif text-3xl md:text-4xl text-ink mb-12">{t.faq.title}</h2>

    <div>
      {items.map(({ q, a }) => (
        <details class="group py-6 border-t border-hairline">
          <summary class="flex items-start justify-between gap-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <h3 class="font-serif text-xl text-ink">{q}</h3>
            <span class="text-moss text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="text-ink-2 leading-relaxed mt-4">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
