---
interface Props { t: any }
const { t } = Astro.props

const features = [
  t.features.lisa,
  t.features.youtube,
  t.features.podcasts,
  t.features.starterDecks,
  t.features.interface,
  t.features.courses,
  t.features.srs,
  t.features.tts,
  t.features.import,
]
// A hairline index, not a grid of cards. Each feature used to be a shadowed
// tile led by an emoji; the redesign has no emoji and no cards, and nine of
// them competed with the words they were meant to introduce.
---

<section id="features" class="py-24 px-6 border-t border-hairline">
  <div class="max-w-5xl mx-auto">
    <div class="max-w-2xl mb-16">
      <h2 class="font-serif text-3xl md:text-4xl text-ink mb-4">{t.features.title}</h2>
      <p class="text-ink-2 text-lg leading-relaxed">{t.features.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12">
      {features.map(({ title, desc }) => (
        <div class="py-6 border-t border-hairline">
          <h3 class="font-serif text-lg text-ink mb-2">{title}</h3>
          <p class="text-ink-2 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
