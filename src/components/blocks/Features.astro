---
import Glyph from '../ui/Glyph.astro'

interface Props { t: any }
const { t } = Astro.props

// Glyph per feature — a line drawing in the same ink as the text, so the
// eye gets a landing point per item without a second colour entering the
// page. Each feature used to be a shadowed tile led by an emoji; the
// redesign has no emoji and no cards, but removing the mark entirely left
// nine headings reading as one undifferentiated block.
const features = [
  { glyph: 'coach', ...t.features.lisa },
  { glyph: 'video', ...t.features.youtube },
  { glyph: 'podcast', ...t.features.podcasts },
  { glyph: 'decks', ...t.features.starterDecks },
  { glyph: 'globe', ...t.features.interface },
  { glyph: 'book', ...t.features.courses },
  { glyph: 'clock', ...t.features.srs },
  { glyph: 'sound', ...t.features.tts },
  { glyph: 'inbox', ...t.features.import },
]
---

<section id="features" class="py-24 px-6 border-t border-hairline">
  <div class="max-w-5xl mx-auto">
    <div class="max-w-2xl mb-16">
      <h2 class="font-serif text-3xl md:text-4xl text-ink mb-4">{t.features.title}</h2>
      <p class="text-ink-2 text-lg leading-relaxed">{t.features.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12">
      {features.map(({ glyph, title, desc }) => (
        <div class="py-6 border-t border-hairline">
          <Glyph name={glyph} size={32} class="text-moss mb-5" />
          <h3 class="font-serif text-lg text-ink mb-2">{title}</h3>
          <p class="text-ink-2 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
