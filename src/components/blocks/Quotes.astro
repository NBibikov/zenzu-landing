---
interface Props { t: any }
const { t } = Astro.props

const quotes = [
  { text: t.quotes.quote1Text, author: t.quotes.quote1Author },
  { text: t.quotes.quote2Text, author: t.quotes.quote2Author },
  { text: t.quotes.quote3Text, author: t.quotes.quote3Author },
]
---

<section class="py-24 px-6 bg-paper-2">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-serif text-2xl text-ink mb-16">{t.quotes.title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {quotes.map(({ text, author }) => (
        <figure class="flex flex-col border-t border-hairline pt-6">
          <blockquote class="font-serif text-ink text-lg leading-[1.55] flex-1 mb-6">
            {text}
          </blockquote>
          <figcaption class="text-ink-3 text-sm">— {author}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
