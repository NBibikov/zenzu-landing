---
interface Props { t: any }
const { t } = Astro.props
---

<section class="py-24 px-6 border-t border-hairline">
  <div class="max-w-2xl mx-auto text-center">
    <p class="text-moss text-xs font-medium uppercase tracking-[0.18em] mb-6">
      {t.name.kicker}
    </p>
    <h2 class="font-serif text-3xl md:text-4xl text-ink leading-[1.2] mb-6">
      {t.name.title}
    </h2>
    <p class="text-ink-2 text-lg leading-relaxed">
      {t.name.body}
    </p>
  </div>
</section>
