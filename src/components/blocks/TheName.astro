---
interface Props { t: any }
const { t } = Astro.props
---

<section class="relative py-20 px-6 overflow-hidden">
  <img src="/stone.png" alt="" class="absolute -bottom-6 left-6 w-32 opacity-[0.07] pointer-events-none select-none" />
  <img src="/lantern.png" alt="" class="absolute top-10 right-8 w-32 opacity-[0.07] pointer-events-none select-none" />

  <div class="relative max-w-2xl mx-auto text-center">
    <span class="inline-block text-moss text-xs font-semibold uppercase tracking-[0.2em] mb-5">
      {t.name.kicker}
    </span>
    <h2 class="text-3xl md:text-4xl font-bold text-moss-dark leading-tight mb-6">
      {t.name.title}
    </h2>
    <p class="text-on-surface-muted text-lg leading-relaxed">
      {t.name.body}
    </p>
  </div>
</section>
