---
interface Props { t: any }
const { t } = Astro.props
// Moss is an accent, never a field: this section used to be a full-bleed moss
// block with white type, the single loudest thing on the page.
---

<section class="py-28 px-6 border-t border-hairline">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-serif text-3xl md:text-4xl text-ink leading-[1.2] mb-6">{t.cta.title}</h2>
    <p class="text-ink-2 text-lg mb-12 leading-relaxed">{t.cta.subtitle}</p>
    <a
      href="https://app.zenzu.app"
      class="inline-block bg-ink text-paper px-10 py-4 rounded-full text-base font-medium hover:bg-moss-dark transition-colors"
    >
      {t.cta.button}
    </a>
  </div>
</section>
