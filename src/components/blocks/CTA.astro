---
import { CONTACT_EMAIL, mailtoHref } from '../../lib/contact'

interface Props { t: any }
const { t } = Astro.props
// Moss is an accent, never a field: this section used to be a full-bleed moss
// block with white type, the single loudest thing on the page.
---

<section class="py-28 px-6 border-t border-hairline">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="font-serif text-3xl md:text-4xl text-ink leading-[1.2] mb-6">{t.cta.title}</h2>
    <p class="text-ink-2 text-lg mb-12 leading-relaxed">{t.cta.subtitle}</p>
    <a href="https://app.zenzu.app" class="zz-btn px-10">
      {t.cta.button}
    </a>
    <!-- A quiet way to reach us, not another call to action. -->
    <p class="mt-10 text-sm text-ink-3 leading-relaxed">
      {t.cta.writeLead}{' '}
      <a href={mailtoHref(t.contact.subject)} class="text-ink-2 underline decoration-hairline underline-offset-4 hover:text-ink hover:decoration-ink transition-colors">{CONTACT_EMAIL}</a>{' '}
      {t.cta.writeTail}
    </p>
  </div>
</section>
