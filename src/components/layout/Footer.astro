---
import { localeNames, localePath, supportedLocales, type Locale } from '../../i18n'
import { CONTACT_EMAIL, mailtoHref } from '../../lib/contact'
import { languageSwitchPath } from '../../lib/language-switch'
import { WEB_APP_URL } from '../../lib/links'

interface Props { t: any; locale: Locale }
const { t, locale } = Astro.props
const currentYear = new Date().getFullYear()
// Same target as the header switch: on a blog, contact or MCP page the
// reader stays on that page; elsewhere the link goes to the home page.
const switchTarget = languageSwitchPath(Astro.url.pathname)
// Paper to the end. A dark moss slab under a light page read as a different
// site, and moss is an accent here, not a field.
---

<footer class="border-t border-hairline text-ink-2 py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <h3 class="font-serif text-ink text-lg mb-3">Zenzu</h3>
        <p class="text-sm leading-relaxed">{t.footer.brand}</p>
      </div>
      <div>
        <h4 class="zz-kicker text-ink mb-1">{t.footer.product}</h4>
        <ul class="text-sm">
          <li><a href={localePath('/', locale) + '#features'} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.nav.features}</a></li>
          <li><a href={localePath('/', locale) + '#how-it-works'} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.nav.howItWorks}</a></li>
          <li><a href={localePath('/blog/', locale)} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.nav.blog}</a></li>
          <li><a href="/compare/" class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.footer.compare}</a></li>
          <li><a href={localePath('/mcp/', locale)} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.footer.mcp}</a></li>
          <li><a href={WEB_APP_URL} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.app.open}</a></li>
        </ul>
      </div>
      <div>
        <h4 class="zz-kicker text-ink mb-1">{t.footer.legal}</h4>
        <ul class="text-sm">
          <li><a href={localePath('/privacy/', locale)} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.footer.privacy}</a></li>
          <li><a href={localePath('/terms/', locale)} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.footer.terms}</a></li>
          <li><a href={localePath('/contact/', locale)} class="inline-flex items-center min-h-11 hover:text-ink transition-colors">{t.footer.contact}</a></li>
          <!-- A quiet way to reach us, next to the contact page. The link stays
               inline in the sentence; its vertical padding makes a 44px tap
               area without moving the lines. -->
          <li class="mt-3 leading-relaxed">
            {t.footer.writeLead}{' '}
            <a href={mailtoHref(t.contact.subject)} class="py-3.5 text-ink underline decoration-hairline underline-offset-4 hover:decoration-ink transition-colors whitespace-nowrap">{CONTACT_EMAIL}</a>{' '}
            {t.footer.writeTail}
          </li>
        </ul>
      </div>
    </div>
    <!-- Every interface language, the current one on the swash. -->
    <nav class="mt-12 pt-8 border-t border-hairline" aria-label={t.nav.languages}>
      <ul class="flex flex-wrap justify-center gap-x-6 text-sm">
        {supportedLocales.map((loc) => (
          <li>
            <a
              href={localePath(switchTarget, loc)}
              lang={loc}
              class:list={['inline-flex items-center min-h-11', loc === locale ? 'text-ink font-semibold' : 'hover:text-ink transition-colors']}
              aria-current={loc === locale ? 'true' : undefined}
            >
              <span class:list={['zz-swash', loc !== locale && 'zz-swash-hover']}>{localeNames[loc]}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-8 text-sm text-ink-3 text-center">
      &copy; {currentYear} Zenzu. {t.footer.rights}
    </div>
  </div>
</footer>
