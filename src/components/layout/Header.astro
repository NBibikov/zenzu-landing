---
import { localeNames, supportedLocales, localePath, type Locale } from '../../i18n'

interface Props {
  t: any
  locale: Locale
}
const { t, locale } = Astro.props

// The blog is the only section with its own pages, so it is the only nav
// item that can be "current". It wears the swash, as a selected nav item
// does in the app, and stays bold so the state never rests on colour.
const onBlog = /\/blog\//.test(Astro.url.pathname)
// On a blog or contact page the language switch keeps the reader there:
// both exist in every locale.
const onContact = /\/contact\/$/.test(Astro.url.pathname)
const switchTarget = onBlog ? '/blog/' : onContact ? '/contact/' : '/'
---

<header class="fixed top-0 left-0 right-0 z-50 bg-paper/90 backdrop-blur-lg border-b border-hairline">
  <nav class="max-w-6xl mx-auto px-5 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!--
      Wordmark: ensō stroke + lowercase "zen" heavy / "zu" light, same as the
      app chrome. Lowercase and the zen/zu split keep the capital Z from
      reading as anything but the word "zen". Not localized on purpose.
    -->
    <a href={localePath('/', locale)} class="flex items-center gap-2 font-sans text-lg text-ink" aria-label="zenzu">
      <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.4 5.9 A8.6 8.6 0 1 0 20.3 14.6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <path d="M18.4 5.9 A8.6 8.6 0 1 0 20.3 14.6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="0 14 40" opacity="0.55"/>
      </svg>
      <span aria-hidden="true"><span class="font-semibold">zen</span><span class="text-ink-2">zu</span></span>
    </a>

    <div class="flex items-center gap-5 md:gap-8 ml-auto">
      <a href={localePath('/', locale) + '#features'} class="hidden md:inline text-sm text-ink-2 hover:text-ink transition-colors">
        {t.nav.features}
      </a>
      <a href={localePath('/', locale) + '#how-it-works'} class="hidden md:inline text-sm text-ink-2 hover:text-ink transition-colors">
        {t.nav.howItWorks}
      </a>
      <a
        href={localePath('/blog/', locale)}
        class:list={[
          'zz-swash text-sm transition-colors',
          onBlog ? 'text-ink font-semibold' : 'zz-swash-hover text-ink-2 hover:text-ink',
        ]}
        aria-current={onBlog ? 'page' : undefined}
      >
        {t.nav.blog}
      </a>

      <!-- Language switcher: opens on hover, and on a
           click or tap (data-open), so touch and keyboard work too. -->
      <div class="relative group hidden sm:block" data-lang-menu>
        <button
          type="button"
          class="text-sm text-ink-2 hover:text-ink transition-colors flex items-center gap-1"
          aria-expanded="false"
          aria-label={t.nav.languages}
        >
          {locale.toUpperCase()}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute top-full right-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-data-[open]:opacity-100 group-data-[open]:visible transition-all">
          <ul class="bg-paper border border-rule rounded-[10px] py-2 min-w-40">
            {supportedLocales.map((loc) => (
              <li>
                <a
                  href={localePath(switchTarget, loc)}
                  lang={loc}
                  class="block px-5 py-2 text-sm text-ink-2 hover:text-ink transition-colors"
                  aria-current={loc === locale ? 'true' : undefined}
                >
                  <span class:list={[loc === locale && 'zz-swash text-ink font-semibold']}>{localeNames[loc]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href="https://app.zenzu.app" class="zz-btn zz-btn-sm">
        {t.nav.getStarted}
      </a>
    </div>
  </nav>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-lang-menu]')
  const button = menu?.querySelector('button')
  if (menu && button) {
    const setOpen = (open: boolean) => {
      menu.toggleAttribute('data-open', open)
      button.setAttribute('aria-expanded', String(open))
    }
    button.addEventListener('click', () => setOpen(!menu.hasAttribute('data-open')))
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) setOpen(false)
    })
    menu.addEventListener('focusout', (e) => {
      if (!menu.contains(e.relatedTarget as Node)) setOpen(false)
    })
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false)
        button.focus()
      }
    })
  }
</script>
