---
import { localeNames, supportedLocales, localePath, type Locale } from '../../i18n'

interface Props {
  t: any
  locale: Locale
}
const { t, locale } = Astro.props
---

<header class="fixed top-0 left-0 right-0 z-50 bg-paper/85 backdrop-blur-lg border-b border-hairline">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <!--
      Wordmark: ensō stroke + lowercase "zen" heavy / "zu" light, same as the
      app chrome. Lowercase and the zen/zu split keep the capital Z from
      reading as anything but the word "zen". Not localized on purpose.
    -->
    <a href={localePath('/', locale)} class="flex items-center gap-2 font-sans text-lg text-ink" aria-label="zenzu">
      <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.4 5.9 A8.6 8.6 0 1 0 20.3 14.6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
        <path d="M18.4 5.9 A8.6 8.6 0 1 0 20.3 14.6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="0 14 40" opacity="0.55"/>
      </svg>
      <span aria-hidden="true"><span class="font-semibold">zen</span><span class="text-ink-2">zu</span></span>
    </a>

    <!-- Nav links (desktop) -->
    <div class="hidden md:flex items-center gap-8">
      <a href={localePath('/', locale) + '#features'} class="text-sm text-ink-2 hover:text-ink transition-colors">
        {t.nav.features}
      </a>
      <a href={localePath('/', locale) + '#how-it-works'} class="text-sm text-ink-2 hover:text-ink transition-colors">
        {t.nav.howItWorks}
      </a>
      <a href={localePath('/blog/', locale)} class="text-sm text-ink-2 hover:text-ink transition-colors">
        {t.nav.blog}
      </a>

      <!-- Language switcher -->
      <div class="relative group">
        <button class="text-sm text-ink-2 hover:text-ink transition-colors flex items-center gap-1">
          {locale.toUpperCase()}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="absolute top-full right-0 mt-1 bg-paper border border-hairline rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all py-1 min-w-36">
          {supportedLocales.map((loc) => (
            <a
              href={localePath('/', loc)}
              class={`block px-4 py-2 text-sm hover:bg-paper-2 transition-colors ${loc === locale ? 'text-ink font-medium' : 'text-ink-2'}`}
            >
              {localeNames[loc]}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- CTA -->
    <a
      href="https://app.zenzu.app"
      class="bg-ink text-paper px-5 py-2 rounded-full text-sm font-medium hover:bg-moss-dark transition-colors"
    >
      {t.nav.getStarted}
    </a>
  </nav>
</header>
