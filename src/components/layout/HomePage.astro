---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import Hero from '../blocks/Hero.astro'
import Screens from '../blocks/Screens.astro'
import TheName from '../blocks/TheName.astro'
import ForWhom from '../blocks/ForWhom.astro'
import Features from '../blocks/Features.astro'
import HowItWorks from '../blocks/HowItWorks.astro'
import Mcp from '../blocks/Mcp.astro'
import Faq from '../blocks/Faq.astro'
import CTA from '../blocks/CTA.astro'
import { t, supportedLocales, localePath, type Locale } from '../../i18n'
import { APP_STORE_URL, PLAY_STORE_URL } from '../../lib/links'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const strings = t(locale)

const site = Astro.site!.toString().replace(/\/$/, '')
const homeUrl = (loc: Locale) => `${site}${localePath('/', loc)}`

const alternates = supportedLocales.map(loc => ({ hreflang: loc, href: homeUrl(loc) }))

// One @graph so the organization, the site and the app reference each other by @id.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'Zenzu',
      url: `${site}/`,
      logo: `${site}/zenzu-icon.png`,
      email: 'hello@zenzu.app',
      sameAs: [APP_STORE_URL, PLAY_STORE_URL],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Zenzu',
      url: `${site}/`,
      inLanguage: [...supportedLocales],
      publisher: { '@id': `${site}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: 'Zenzu',
      alternateName: 'Zenzu: AI Language Mastery',
      description: strings.meta.description,
      url: homeUrl(locale),
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'iOS 15.0 or later, Android, Web',
      installUrl: [APP_STORE_URL, PLAY_STORE_URL],
      downloadUrl: [APP_STORE_URL, PLAY_STORE_URL],
      inLanguage: [...supportedLocales],
      image: `${site}/og-default.png`,
      featureList: [
        'Learn from YouTube videos with an interactive transcript',
        'AI-transcribed podcasts',
        'Save any word or phrase as a flashcard with sentence context',
        'FSRS-6 spaced repetition scheduling',
        'AI language coach that replies in your native language',
        'Grammar and vocabulary courses sorted by CEFR level',
        'Pronunciation audio for every word and sentence',
        'Interface in English, Ukrainian, German, French, Spanish and Portuguese',
      ],
      publisher: { '@id': `${site}/#organization` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${homeUrl(locale)}#faq`,
      inLanguage: locale,
      mainEntity: strings.faq.items.map(({ q, a }: { q: string; a: string }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
}
---

<BaseLayout
  title={strings.meta.title}
  description={strings.meta.description}
  lang={locale}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <!-- Skip link: the first focusable element, shown only on focus. The
       header is fixed, so it sits above it; <main> takes the focus. -->
  <a
    href="#main"
    data-skip
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:inline-flex focus:items-center focus:min-h-11 focus:px-5 focus:bg-paper focus:text-ink focus:text-sm focus:border focus:border-rule focus:rounded-[10px]"
  >
    {strings.nav.skip}
  </a>
  <Header t={strings} locale={locale} />
  <main id="main" class="focus:outline-none">
    <Hero t={strings} />
    <Screens t={strings} locale={locale} />
    <HowItWorks t={strings} />
    <Features t={strings} />
    <ForWhom t={strings} />
    <TheName t={strings} />
    <Mcp t={strings} locale={locale} />
    <Faq t={strings} />
    <CTA t={strings} />
  </main>
  <Footer t={strings} locale={locale} />
</BaseLayout>

<script>
  // Without a script the fragment still moves the Tab start point to <main>.
  // With it, <main> takes the focus for screen readers too, and gives the
  // tabindex back on blur, so a later click on page text does not focus it.
  const skip = document.querySelector<HTMLAnchorElement>('[data-skip]')
  const main = document.getElementById('main')
  skip?.addEventListener('click', (e) => {
    if (!main) return
    e.preventDefault()
    main.setAttribute('tabindex', '-1')
    main.focus()
    main.scrollIntoView()
    main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true })
  })
</script>
