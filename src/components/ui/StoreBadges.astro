---
import { APP_STORE_URL, PLAY_STORE_URL } from '../../lib/links'

interface Props { t: any }
const { t } = Astro.props
// The border is ink-3, not rule: on paper rule is 1.64:1, and the edge of a
// control needs 3:1. The store names stay in English; only the captions
// are localised.
const badge =
  'inline-flex items-center gap-3 min-w-52 border border-ink-3 text-ink px-6 py-3 rounded-[16px] hover:border-ink transition-colors'
---

<div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6">
  <a href={APP_STORE_URL} target="_blank" rel="noopener" class={badge}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.05 20.28c-.98.95-2.05.86-3.08.4-1.09-.47-2.09-.51-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
    </svg>
    <div class="flex flex-col items-start leading-tight text-left">
      <span class="text-[11px] uppercase tracking-wide text-ink-3">{t.stores.appStoreCaption}</span>
      <span class="text-base font-medium -mt-0.5">App Store</span>
    </div>
  </a>
  <a href={PLAY_STORE_URL} target="_blank" rel="noopener" class={badge}>
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3.61 1.81 13.79 12 3.61 22.19a1.5 1.5 0 0 1-.61-1.21V3.02c0-.5.24-.93.61-1.21zm11.24 11.25 2.35 2.35-11.14 6.33 8.79-8.68zm3.65-3.65 2.66 1.51c.81.46.81 1.6 0 2.06l-2.66 1.51L15.9 12l2.6-2.59zM6.06 2.26 17.2 8.59l-2.35 2.35-8.79-8.68z"/>
    </svg>
    <div class="flex flex-col items-start leading-tight text-left">
      <span class="text-[11px] uppercase tracking-wide text-ink-3">{t.stores.googlePlayCaption}</span>
      <span class="text-base font-medium -mt-0.5">Google Play</span>
    </div>
  </a>
</div>
