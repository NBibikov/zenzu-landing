---
// Questions and answers as native <details>. Every answer stays in the HTML,
// so crawlers and answer engines read it without running any script. The
// home FAQ and the MCP page use this list.
// The row padding sits on <summary>, so the whole row is the tap target.
// The + mark matches the Features toggle: same size, turns into a cross.
// Several answers may stay open: an exclusive list (name="faq") closes an
// answer above the one just opened, the page jumps up, and the question the
// reader tapped moves out of place; readers also compare two answers.
interface Props {
  items: { q: string; a: string }[]
}
const { items } = Astro.props
---

<div>
  {items.map(({ q, a }) => (
    <details class="group border-t border-hairline">
      <summary class="flex items-start justify-between gap-6 py-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <h3 class="font-serif text-xl text-ink">{q}</h3>
        <span class="zz-plus" aria-hidden="true">+</span>
      </summary>
      <p class="text-ink-2 leading-relaxed -mt-2 pb-6">{a}</p>
    </details>
  ))}
</div>
