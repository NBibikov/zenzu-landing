---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { t } from '../i18n'

interface Props {
  title: string
}

const { title } = Astro.props
const locale = 'en'
const strings = t(locale)
---

<BaseLayout title={`${title} — Zenzu`}>
  <Header t={strings} locale={locale} />
  <main class="pt-32 pb-24 px-6">
    <article class="zz-prose prose prose-lg max-w-3xl mx-auto
      prose-h1:text-4xl prose-h1:mb-2
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-hairline prose-h2:pb-2
      prose-h3:text-lg prose-h3:mt-6
      prose-p:text-ink-2 prose-li:text-ink-2
    ">
      <h1>{title}</h1>
      <p class="text-sm !text-ink-3 !mt-0">Last updated: April 6, 2026</p>
      <hr class="!mt-4 !mb-8 border-rule" />
      <slot />
    </article>
  </main>
  <Footer t={strings} locale={locale} />
</BaseLayout>
